{
  "ConnectionStrings": {
    "AuthDb": "Data Source=(localdb)\\MSSQLLocalDB;Initial Catalog=Communityconnect;Integrated Security=True;Persist Security Info=False;Pooling=False;MultipleActiveResultSets=False;Encrypt=True;TrustServerCertificate=False;Command Timeout=0"
    //"AuthDb": "Data Source=tcp:communityconnect-dev-db.cv4komqwqjgi.ap-south-1.rds.amazonaws.com,1433;Database=CommunityConnect;Persist Security Info=False;User ID=admin;Password=Suryawanshi;Pooling=False;MultipleActiveResultSets=False;Encrypt=True;TrustServerCertificate=True;Application Name=CommunityConnect.API;Command Timeout=30"
  },
  "Jwt": {
    "SecretKey": "YourSuperSecretKeyHereThatIsAtLeast32CharactersLong",
    "Issuer": "CommunityConnect",
    "Audience": "CommunityConnect.API",
    "ExpiryMinutes": 15
  },
  "Redis": {
    "ConnectionString": "your-elasticache-endpoint:6379",
    "InstanceName": "CommunityConnect_API_",
    "DefaultTTLMinutes": 5
  },
  "Cors": {
    "AllowedOrigins": [
      "https://communityconnect.com",
      "https://www.communityconnect.com"
    ],
    "AllowedMethods": [
      "GET",
      "POST",
      "PUT",
      "DELETE",
      "OPTIONS"
    ],
    "AllowedHeaders": [
      "Content-Type",
      "Authorization",
      "X-Requested-With",
      "X-ClientId"
    ],
    "AllowCredentials": true
  },
  "IpRateLimiting": {
    "EnableEndpointRateLimiting": true,
    "StackBlockedRequests": false,
    "RealIpHeader": "X-Real-IP",
    "ClientIdHeader": "X-ClientId",
    "HttpStatusCode": 429,
    "GeneralRules": [
      {
        "Endpoint": "*",
        "Period": "1m",
        "Limit": 100
      },
      {
        "Endpoint": "*",
        "Period": "1h",
        "Limit": 1000
      }
    ]
  },
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {Message:lj} {Properties:j}{NewLine}{Exception}"
        }
      }
    ]
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
