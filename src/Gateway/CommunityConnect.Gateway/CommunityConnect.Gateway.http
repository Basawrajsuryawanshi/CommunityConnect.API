###############################################
# CommunityConnect API Gateway - HTTP Tests
# Use with Visual Studio HTTP Client or REST Client Extension
###############################################

@gateway = http://localhost:5000
@token = YOUR_JWT_TOKEN_HERE

###############################################
# HEALTH & STATUS
###############################################

### Health Check
GET {{gateway}}/health

### Ready Check
GET {{gateway}}/health/ready

###############################################
# AUTH SERVICE (Port 5001) - No Auth Required
###############################################

### Register User
POST {{gateway}}/api/auth/register
Content-Type: application/json

{
  "email": "newuser@example.com",
  "password": "SecurePassword123!",
  "firstName": "John",
  "lastName": "Doe"
}

### Login - Get JWT Token
POST {{gateway}}/api/auth/login
Content-Type: application/json

{
  "email": "test@example.com",
  "password": "password123"
}

### Refresh Token
POST {{gateway}}/api/auth/refresh
Content-Type: application/json

{
  "refreshToken": "your-refresh-token"
}

###############################################
# USER SERVICE (Port 5002) - Auth Required
###############################################

### Get Current User Profile (Cached - 5 min TTL)
GET {{gateway}}/api/user/profile
Authorization: Bearer {{token}}

### Get User by ID (Cached - 5 min TTL)
GET {{gateway}}/api/user/123
Authorization: Bearer {{token}}

### Update Profile
PUT {{gateway}}/api/user/profile
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "firstName": "John",
  "lastName": "Doe",
  "bio": "Software Engineer",
  "location": "San Francisco, CA"
}

### Get User's Communities
GET {{gateway}}/api/user/communities
Authorization: Bearer {{token}}

###############################################
# EVENT SERVICE (Port 5003) - Auth Required
###############################################

### Get All Events (Cached - 1 min TTL)
GET {{gateway}}/api/event?page=1&pageSize=10
Authorization: Bearer {{token}}

### Get Event by ID (Cached - 1 min TTL)
GET {{gateway}}/api/event/abc123
Authorization: Bearer {{token}}

### Create Event
POST {{gateway}}/api/event
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "title": "Community Meetup 2025",
  "description": "Annual community gathering",
  "startDate": "2025-06-15T18:00:00Z",
  "endDate": "2025-06-15T21:00:00Z",
  "location": "Downtown Hall",
  "maxAttendees": 100
}

### Update Event
PUT {{gateway}}/api/event/abc123
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "title": "Updated Event Title",
  "description": "Updated description"
}

### Delete Event
DELETE {{gateway}}/api/event/abc123
Authorization: Bearer {{token}}

### Register for Event
POST {{gateway}}/api/event/abc123/register
Authorization: Bearer {{token}}

###############################################
# DISCUSSION SERVICE (Port 5004) - Auth Required
###############################################

### Get All Discussions (Cached - 2 min TTL)
GET {{gateway}}/api/discussion?communityId=123
Authorization: Bearer {{token}}

### Get Discussion by ID
GET {{gateway}}/api/discussion/xyz789
Authorization: Bearer {{token}}

### Create Discussion
POST {{gateway}}/api/discussion
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "communityId": "123",
  "title": "What features would you like to see?",
  "content": "Let's discuss upcoming features",
  "tags": ["feature-request", "feedback"]
}

### Add Comment to Discussion
POST {{gateway}}/api/discussion/xyz789/comments
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "content": "Great idea! I would love to see this feature."
}

### Like Discussion
POST {{gateway}}/api/discussion/xyz789/like
Authorization: Bearer {{token}}

###############################################
# ANNOUNCEMENT SERVICE (Port 5005) - Auth Required
###############################################

### Get All Announcements (Cached - 3 min TTL)
GET {{gateway}}/api/announcement?communityId=123
Authorization: Bearer {{token}}

### Get Announcement by ID
GET {{gateway}}/api/announcement/456
Authorization: Bearer {{token}}

### Create Announcement (Admin Only)
POST {{gateway}}/api/announcement
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "communityId": "123",
  "title": "Platform Maintenance Notice",
  "content": "We will be performing maintenance on Saturday",
  "priority": "high",
  "expiresAt": "2025-02-01T00:00:00Z"
}

### Delete Announcement
DELETE {{gateway}}/api/announcement/456
Authorization: Bearer {{token}}

###############################################
# NOTIFICATION SERVICE (Port 5006) - Auth Required
###############################################

### Get User Notifications (Cached - 30 sec TTL)
GET {{gateway}}/api/notification?unreadOnly=true
Authorization: Bearer {{token}}

### Mark Notification as Read
PUT {{gateway}}/api/notification/notif123/read
Authorization: Bearer {{token}}

### Mark All as Read
PUT {{gateway}}/api/notification/read-all
Authorization: Bearer {{token}}

### Delete Notification
DELETE {{gateway}}/api/notification/notif123
Authorization: Bearer {{token}}

###############################################
# ANALYTICS SERVICE (Port 5007) - Auth Required
###############################################

### Get Dashboard Stats (Cached - 10 min TTL)
GET {{gateway}}/api/analytics/dashboard
Authorization: Bearer {{token}}

### Get Community Analytics
GET {{gateway}}/api/analytics/community/123?period=30days
Authorization: Bearer {{token}}

### Get Event Analytics
GET {{gateway}}/api/analytics/event/abc123
Authorization: Bearer {{token}}

### Get User Activity
GET {{gateway}}/api/analytics/user/activity?userId=789
Authorization: Bearer {{token}}

###############################################
# MEDIA SERVICE (Port 5008) - Auth Required
###############################################

### Upload Image
POST {{gateway}}/api/media/upload
Authorization: Bearer {{token}}
Content-Type: multipart/form-data; boundary=----WebKitFormBoundary7MA4YWxkTrZu0gW

------WebKitFormBoundary7MA4YWxkTrZu0gW
Content-Disposition: form-data; name="file"; filename="profile.jpg"
Content-Type: image/jpeg

< ./profile.jpg
------WebKitFormBoundary7MA4YWxkTrZu0gW--

### Get Media by ID (Cached - 5 min TTL)
GET {{gateway}}/api/media/med123
Authorization: Bearer {{token}}

### Delete Media
DELETE {{gateway}}/api/media/med123
Authorization: Bearer {{token}}

### Get User's Media
GET {{gateway}}/api/media/user?page=1&pageSize=20
Authorization: Bearer {{token}}

###############################################
# CACHE TESTING
###############################################

### Test Cache - First Request (Should be MISS)
# @name cacheTest1
GET {{gateway}}/api/user/profile
Authorization: Bearer {{token}}

### Test Cache - Second Request (Should be HIT)
# @name cacheTest2
GET {{gateway}}/api/user/profile
Authorization: Bearer {{token}}

###############################################
# RATE LIMITING TESTING
###############################################

### Test Rate Limit - Send Multiple Requests
# Run this multiple times quickly to hit rate limit
GET {{gateway}}/health

###############################################
# CORS TESTING
###############################################

### Preflight Request
OPTIONS {{gateway}}/api/user/profile
Origin: http://localhost:3000
Access-Control-Request-Method: GET
Access-Control-Request-Headers: Authorization

###############################################
# ERROR SCENARIOS
###############################################

### Test 401 - No Token
GET {{gateway}}/api/user/profile

### Test 401 - Invalid Token
GET {{gateway}}/api/user/profile
Authorization: Bearer invalid-token-here

### Test 404 - Invalid Route
GET {{gateway}}/api/invalid/route
Authorization: Bearer {{token}}

### Test 429 - Rate Limit (Run 101 times)
GET {{gateway}}/health

###############################################
# NOTES
###############################################
# 
# Cache Status Headers:
# - X-Cache-Status: HIT  → Response from Redis cache
# - X-Cache-Status: MISS → Fresh response from service
#
# Cache TTL by Service:
# - User Profiles: 5 minutes
# - Events: 1 minute
# - Analytics: 10 minutes
# - Announcements: 3 minutes
# - Discussions: 2 minutes
# - Media: 5 minutes
# - Notifications: 30 seconds
#
# Rate Limits:
# - General: 100 requests/minute per IP
# - Auth: 100/min
# - Notification: 200/min
# - Analytics: 50/min
# - Others: 100/min
#
# Replace {{token}} with actual JWT token from login response
###############################################

